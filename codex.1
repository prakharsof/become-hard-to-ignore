<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#0b1110">
<title>Northstar — Intentional relationships</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--bg:#0b1110;--panel:#111918;--panel2:#151f1d;--line:#25312e;--text:#eff4ed;--muted:#91a09a;--green:#c5f36b;--green2:#91bf47;--orange:#f2a76c;--blue:#9ec9ff;--radius:17px}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 75% -15%,#23352c 0,transparent 38%),var(--bg);font-family:'DM Sans',sans-serif;color:var(--text);min-height:100vh}button,input{font:inherit}.shell{max-width:1440px;margin:auto;padding:24px 34px 48px}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:34px}.brand{display:flex;align-items:center;gap:11px;font:800 19px Manrope,sans-serif;letter-spacing:-.6px}.mark{width:32px;height:32px;border-radius:10px;background:var(--green);display:grid;place-items:center;color:#101610}.mark svg{width:19px}.topright{display:flex;align-items:center;gap:17px;color:var(--muted);font-size:13px}.date{font:12px 'DM Mono',monospace}.avatar{width:34px;height:34px;border-radius:50%;background:#29362f;color:var(--green);display:grid;place-items:center;font-weight:700}.hero{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:27px}.eyebrow{font:11px 'DM Mono',monospace;color:var(--green);letter-spacing:1.6px;text-transform:uppercase;margin-bottom:12px}.hero h1{font:700 clamp(30px,4vw,43px) Manrope,sans-serif;letter-spacing:-1.6px;margin:0 0 9px}.hero p{color:var(--muted);margin:0;font-size:14px}.week{border:1px solid var(--line);background:#111917b8;border-radius:12px;padding:10px 14px;color:var(--muted);font:11px 'DM Mono',monospace}.week b{color:var(--text);font-weight:500}.grid{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(290px,.9fr);gap:18px}.left,.right{display:grid;align-content:start;gap:18px}.card{background:linear-gradient(145deg,#131b19,#101615);border:1px solid var(--line);border-radius:var(--radius);padding:21px}.cardhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:17px}.cardtitle{font:650 15px Manrope,sans-serif;letter-spacing:-.25px}.subtle{font-size:12px;color:var(--muted)}.focus{padding:23px 23px 20px}.focusrow{display:flex;justify-content:space-between;align-items:flex-start}.focuslabel{font:10px 'DM Mono',monospace;color:var(--green);text-transform:uppercase;letter-spacing:1.4px}.focus h2{font:650 22px Manrope,sans-serif;letter-spacing:-.6px;margin:10px 0 5px}.focus p{font-size:13px;color:var(--muted);margin:0}.badge{font:10px 'DM Mono',monospace;color:var(--green);border:1px solid #425732;background:#25301f;padding:7px 9px;border-radius:30px}.progressline{display:flex;justify-content:space-between;margin:22px 0 8px;font:11px 'DM Mono',monospace;color:var(--muted)}.progressline span:last-child{color:var(--text)}.track{height:5px;border-radius:9px;background:#26302d;overflow:hidden}.fill{height:100%;width:0;background:var(--green);border-radius:9px;transition:width .3s}.focusfoot{display:flex;gap:8px;align-items:center;margin-top:15px;color:var(--muted);font-size:11px}.dot{width:6px;height:6px;border-radius:50%;background:var(--green)}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:11px}.metric{border:1px solid var(--line);border-radius:13px;padding:14px 14px 13px;background:#121a18}.metriclabel{font:10px 'DM Mono',monospace;color:var(--muted);text-transform:uppercase;letter-spacing:.6px}.metricnum{font:700 24px Manrope,sans-serif;letter-spacing:-1px;margin:11px 0 3px}.metricfoot{font-size:11px;color:var(--muted)}.metricfoot em{color:var(--green);font-style:normal}.sectiontitle{font:650 15px Manrope,sans-serif;margin:0}.tasks{display:grid;gap:2px}.task{display:grid;grid-template-columns:22px 1fr auto;align-items:center;gap:12px;padding:12px 2px;border-bottom:1px solid #202a27}.task:last-child{border-bottom:0}.check{height:19px;width:19px;border:1px solid #46534e;border-radius:6px;cursor:pointer;background:transparent;display:grid;place-items:center;color:#121812}.check.done{background:var(--green);border-color:var(--green)}.check svg{display:none;width:13px}.check.done svg{display:block}.taskname{font-size:13px;font-weight:550}.taskmeta{font-size:11px;color:var(--muted);margin-top:4px}.tag{color:#adc68c;background:#222c20;border-radius:5px;padding:4px 7px;font:9px 'DM Mono',monospace;text-transform:uppercase}.task.complete .taskname{text-decoration:line-through;color:#829089}.addrow{display:flex;gap:8px;margin-top:12px}.addrow input{min-width:0;flex:1;background:#0e1413;border:1px solid var(--line);border-radius:9px;padding:10px 11px;color:var(--text);font-size:12px;outline:none}.addrow input:focus{border-color:#78994a}.addrow button{border:0;border-radius:9px;background:#26351f;color:var(--green);font-size:12px;font-weight:600;padding:0 14px;cursor:pointer}.scorecard{display:flex;gap:19px;align-items:center}.ring{height:83px;width:83px;border-radius:50%;background:conic-gradient(var(--green) var(--angle,0deg),#29332f 0);display:grid;place-items:center;position:relative;flex-shrink:0}.ring:before{content:'';position:absolute;inset:6px;background:#121a18;border-radius:50%}.ringtext{z-index:1;text-align:center;font:700 20px Manrope,sans-serif}.ringtext small{display:block;font:9px 'DM Mono',monospace;color:var(--muted);font-weight:400}.scorecopy strong{font:650 14px Manrope,sans-serif}.scorecopy p{font-size:12px;color:var(--muted);line-height:1.55;margin:6px 0 0}.areas{display:grid;gap:15px}.area{display:grid;grid-template-columns:94px 1fr 30px;align-items:center;gap:10px}.areaname{font-size:11px;color:#c9d2cd}.areabar{height:5px;background:#29332f;border-radius:9px;overflow:hidden}.areabar span{display:block;height:100%;background:#91bf47;border-radius:9px;transition:width .3s}.areanum{text-align:right;font:10px 'DM Mono',monospace;color:var(--muted)}.quote{font:500 13px/1.55 Manrope,sans-serif;color:#d7dfd8}.quote span{display:block;font:10px 'DM Mono',monospace;color:var(--muted);margin-top:12px}.footer{text-align:center;color:#63716b;font:10px 'DM Mono',monospace;margin-top:23px}.toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,20px);padding:11px 16px;background:#d6f99a;color:#172014;border-radius:9px;font-size:12px;font-weight:700;opacity:0;pointer-events:none;transition:.25s}.toast.show{opacity:1;transform:translate(-50%,0)}@media(max-width:900px){.grid{grid-template-columns:1fr}.right{grid-template-columns:1fr 1fr}.right .card:last-child{grid-column:span 2}}@media(max-width:600px){.shell{padding:19px 15px 35px}.top{margin-bottom:28px}.topright .date{display:none}.hero{align-items:flex-start;gap:14px;flex-direction:column}.hero h1{font-size:32px}.metrics{grid-template-columns:repeat(2,1fr)}.right{grid-template-columns:1fr}.right .card:last-child{grid-column:auto}.card{padding:17px}.focus{padding:19px}.area{grid-template-columns:83px 1fr 28px}}
</style></head>
<body><div class="shell"><header class="top"><div class="brand"><div class="mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 20h15L12 3Z"/><path d="M12 9v5m0 3h.01"/></svg></div>northstar</div><div class="topright"><span class="date" id="date"></span><span>YOUR DAILY FIELD GUIDE</span><div class="avatar">Y</div></div></header>
<section class="hero"><div><div class="eyebrow">Connection · honesty · responsibility</div><h1>Build relationships that are real.</h1><p>Make room for mutual desire, clear communication, and a life you can share.</p></div><div class="week"><b id="week"></b> &nbsp;·&nbsp; YOUR CURRENT WEEK</div></section>
<main class="grid"><div class="left"><section class="card focus"><div class="focusrow"><div><div class="focuslabel">This week's focus</div><h2>Choose connection over conquest.</h2><p>Meet people as individuals. Build trust at a pace that works for both of you.</p></div><span class="badge">WEEK 01</span></div><div class="progressline"><span>DAILY COMMITMENTS</span><span id="taskCount">0 / 6 complete</span></div><div class="track"><div class="fill" id="focusFill"></div></div><div class="focusfoot"><i class="dot"></i><span id="focusHint">A strong week starts with one promise kept.</span></div></section>
<section class="metrics"><div class="metric"><div class="metriclabel">Connection</div><div class="metricnum" id="connectionMetric">0</div><div class="metricfoot">intentional moments</div></div><div class="metric"><div class="metriclabel">Communication</div><div class="metricnum" id="communicationMetric">0</div><div class="metricfoot">honest conversations</div></div><div class="metric"><div class="metriclabel">Sexual health</div><div class="metricnum" id="healthMetric">0</div><div class="metricfoot">care &amp; check-ins</div></div><div class="metric"><div class="metriclabel">Future readiness</div><div class="metricnum" id="readinessMetric">0</div><div class="metricfoot">planning steps</div></div></section>
<section class="card"><div class="cardhead"><div><div class="sectiontitle">Today's intentions</div><div class="subtle" style="margin-top:5px">Be clear. Be curious. Respect the answer.</div></div><span class="subtle" id="todayLabel"></span></div><div class="tasks" id="tasks"></div><div class="addrow"><input id="newTask" maxlength="60" placeholder="Add a thoughtful intention…"><button id="addButton">+ Add</button></div></section>
</div><aside class="right"><section class="card"><div class="cardhead"><div class="cardtitle">Today's reflection</div><span class="subtle">DAILY</span></div><div class="scorecard"><div class="ring" id="ring"><div class="ringtext"><span id="score">0</span><small>INTENT</small></div></div><div class="scorecopy"><strong id="scoreTitle">Start with respect.</strong><p id="scoreCopy">A good connection starts with curiosity, honesty, and room for choice.</p></div></div></section>
<section class="card"><div class="cardhead"><div class="cardtitle">Show up with care</div><span class="subtle">TODAY</span></div><div class="areas" id="areas"></div></section>
<section class="card"><div class="cardtitle" style="margin-bottom:12px">A note to self</div><div class="quote">“Mutual interest is a beginning. Trust, honesty, and care are how you build something lasting.”<span>— THE NORTHSTAR PRINCIPLE</span></div></section></aside></main><div class="footer">NORTHSTAR · RELATIONSHIPS BUILT ON MUTUAL CHOICE · YOUR DATA STAYS IN THIS BROWSER</div></div><div class="toast" id="toast"></div>
<script>
const defaults=[{name:'Make a genuine connection',meta:'Be present, curious, and open to mutual interest',area:'Connection',done:false},{name:'State what you are looking for honestly',meta:'Share intentions without pressure',area:'Communication',done:false},{name:'Practice listening without an agenda',meta:'Ask, listen, and accept the answer',area:'Communication',done:false},{name:'Keep a clear boundary',meta:'Notice your needs and respect theirs',area:'Communication',done:false},{name:'Take care of sexual health',meta:'Review testing, protection, and consent practices',area:'Health',done:false},{name:'Invest in a relationship skill',meta:'Reflect, learn, or get support when needed',area:'Connection',done:false},{name:'Build stability for the future',meta:'Take one step on savings, housing, or work',area:'Readiness',done:false},{name:'Reflect on what parenting requires',meta:'Time, care, support, and long-term responsibility',area:'Readiness',done:false}];
const key='northstar-relationships-v1';let data;try{data=JSON.parse(localStorage.getItem(key))||{tasks:defaults,weekKey:getWeekKey()}}catch{data={tasks:defaults,weekKey:getWeekKey()}}if(data.weekKey!==getWeekKey()){data.tasks=defaults;data.weekKey=getWeekKey()}function save(){localStorage.setItem(key,JSON.stringify(data));render()}function getWeekKey(){const d=new Date(),jan=new Date(d.getFullYear(),0,1);return d.getFullYear()+'-'+Math.ceil((((d-jan)/86400000)+jan.getDay()+1)/7)}
const icon='<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m4 10 4 4 8-8"/></svg>';
function render(){const el=document.getElementById('tasks');el.innerHTML='';data.tasks.forEach((t,i)=>{const row=document.createElement('div');row.className='task'+(t.done?' complete':'');row.innerHTML=`<button class="check ${t.done?'done':''}" aria-label="${t.done?'Mark incomplete':'Mark complete'}">${icon}</button><div><div class="taskname"></div><div class="taskmeta"></div></div><span class="tag"></span>`;row.querySelector('.taskname').textContent=t.name;row.querySelector('.taskmeta').textContent=t.meta||'Personal intention';row.querySelector('.tag').textContent=t.area||'Personal';row.querySelector('button').onclick=()=>{data.tasks[i].done=!data.tasks[i].done;save()};el.append(row)});const completed=data.tasks.filter(t=>t.done).length,total=data.tasks.length;document.getElementById('taskCount').textContent=`${completed} / ${total} complete`;document.getElementById('focusFill').style.width=(total?100*completed/total:0)+'%';document.getElementById('focusHint').textContent=completed===total&&total?'You showed up with care today. Carry that forward.':completed?'Good. Keep the next intention small and sincere.':'A strong week starts with one promise kept.';const by=a=>data.tasks.filter(t=>t.area===a&&t.done).length;const n=a=>data.tasks.filter(t=>t.area===a).length;for(const [id,area] of [['connectionMetric','Connection'],['communicationMetric','Communication'],['healthMetric','Health'],['readinessMetric','Readiness']])document.getElementById(id).textContent=`${by(area)} / ${n(area)}`;const score=Math.round(100*(total?completed/total:0));document.getElementById('score').textContent=score;document.getElementById('ring').style.setProperty('--angle',score*3.6+'deg');document.getElementById('scoreTitle').textContent=score===100?'You showed up with care.':score>=50?'Thoughtful progress.':'Start with respect.';document.getElementById('scoreCopy').textContent=score===100?'Notice the effort you brought to your relationships today.':score>=50?'Stay curious. Leave room for the other person’s choice.':'A good connection starts with curiosity, honesty, and room for choice.';document.getElementById('areas').innerHTML=['Connection','Communication','Health','Readiness'].map(a=>{let done=by(a),count=n(a),pct=count?Math.round(100*done/count):0;return `<div class="area"><div class="areaname">${a}</div><div class="areabar"><span style="width:${pct}%"></span></div><div class="areanum">${pct}%</div></div>`}).join('')}
function add(){let input=document.getElementById('newTask'),name=input.value.trim();if(!name){input.focus();return}data.tasks.push({name,meta:'A promise you chose for yourself',area:'Personal',done:false});input.value='';save();toast('Promise added. Make it count.')};document.getElementById('addButton').onclick=add;document.getElementById('newTask').addEventListener('keydown',e=>{if(e.key==='Enter')add()});function toast(text){const t=document.getElementById('toast');t.textContent=text;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),1800)}const now=new Date();document.getElementById('date').textContent=now.toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'}).toUpperCase();document.getElementById('todayLabel').textContent=now.toLocaleDateString(undefined,{weekday:'long',month:'short',day:'numeric'});document.getElementById('week').textContent='WEEK '+String(Math.ceil((now-new Date(now.getFullYear(),0,1))/604800000)).padStart(2,'0');render();
</script></body></html>


